{
  "manifest_version": 3,
  "name": "AskTree",
  "version": "0.1.0",
  "description": "Clip a page or PDF into an AskTree forest and ask about it.",
  "action": { "default_title": "Clip to AskTree" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "storage"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
