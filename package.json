{
  "private": true,
  "name": "asktree-monorepo",
  "scripts": {
    "dev": "pnpm --filter @asktree/web dev",
    "build": "pnpm --filter @asktree/core build && pnpm --filter @asktree/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "tsc -p packages/core/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit && tsc -p apps/extension/tsconfig.json --noEmit",
    "deploy": "pnpm build && gh-pages -d apps/web/dist",
    "build:extension": "pnpm --filter @asktree/core build && pnpm --filter @asktree/extension build"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.0",
    "@testing-library/react": "^16.0",
    "fake-indexeddb": "^6.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^25.0",
    "typescript": "^5.5",
    "vitest": "^2.0"
  }
}
